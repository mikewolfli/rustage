      "principle": "principle #59（不得出现漂移的平行实现）"
    },
    {
      "id": "C-CHANGE",
      "concern": "变更集与其拒绝原因",
      "module": "src/contracts/change.rs",
      "principle": "principle #23（变更可撤销）"
    },
    {
      "id": "C-PERMISSION",
      "concern": "能力、授权、拒绝与撤销",
      "module": "src/contracts/permission.rs",
      "principle": "principle #22（拒绝必须是准确结果）"
    },
    {
      "id": "C-DIAGNOSTIC",
      "concern": "问题、定位与过期标记",
      "module": "src/contracts/diagnostics.rs",
      "principle": "principle #25（失败显式化）"
    },
