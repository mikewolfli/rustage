    {
      "id": "C-STORE",
      "concern": "唯一可写模型与只读视图/快照",
      "module": "src/contracts/store.rs",
      "principle": "principle #6（跨视图/服务没有第二份可写模型）"
    }
  ],
  "grants": {
    "agent-autonomous": "agent 可自主：可逆、无副作用、由变更集记录",
    "needs-review": "需评审通过：影响布局与生成代码结构",
    "needs-confirmation": "需人确认：没有生成器或门禁保护",
