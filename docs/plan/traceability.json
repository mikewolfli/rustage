  "gates": [
    {
      "id": "rust-test",
      "command": "cargo test",
      "covers": "Rust 单元测试、契约不变量与库层探针的断言",
      "mode": "manual",
      "reason": "需要 Rust 工具链与 git 依赖拉取，尚未在 CI 实测",
      "owner": "T00.08 / CI 维护者"
    },
    {
      "id": "rust-fmt",
      "command": "cargo fmt --check",
      "covers": "格式",
      "mode": "manual",
      "reason": "同上",
      "owner": "T00.08 / CI 维护者"
    },
    {
      "id": "rust-clippy",
      "command": "cargo clippy --all-targets",
      "covers": "静态检查；不得新增警告",
      "mode": "manual",
      "reason": "同上",
      "owner": "T00.08 / CI 维护者"
    },
    {
      "id": "probe-apis",
      "command": "cargo run -- --probe-apis target/probe",
      "covers": "固定修订上的库契约探针；有缺口时退出码为 1",
      "mode": "manual",
      "reason": "缺口存在时该命令刻意失败，需人工判读",
      "owner": "T00.08 / CI 维护者"
    },
